{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@signal-engine/*": [
        "signal-engine/*"
      ]
    },
    "allowJs": true
  },
  "include": [
    "signal-engine/**/*.ts",
    "src/**/*.ts",
    "__fixtures__/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "apollo-lead-engine",
    "WORDPRESS-PLUGIN"
  ]
}
